rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read/write to their own folder only
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Order-related assets (e.g. package photos) — only the order's customer can write
    match /orders/{orderId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }
    // Legacy flat order paths (booking items use items/{timestamp}.jpg)
    match /items/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    // Delivery completion photos — authenticated users can upload (CF validates driver ownership)
    // File size limited to prevent storage abuse
    match /deliveries/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
  }
}
